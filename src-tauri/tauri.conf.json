{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Nocta",
  "version": "../package.json",
  "identifier": "com.wade.nocta",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [
      {
        "title": "Nocta · 夜幕",
        "width": 1280,
        "height": 800,
        "minWidth": 960,
        "minHeight": 600,
        "transparent": true,
        "decorations": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis",
      "dmg",
      "deb"
    ],
    "windows": {
      "nsis": {
        "compression": "zlib"
      }
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": ["lib/**/*"]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDUxQzE0Rjg1RDk5NDUzQzAKUldUQVU1VFpoVS9CVVVMelpTc0RSZ2N0OHl5YjJiVnJGZy9pWkhidFZsQ0FaWCswbk16ZjQ0SlcK",
      "endpoints": [
        "https://github.com/wade6716/Nocta/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
